Если цель заработать на процентах по рассрочке. то возможно следует более детально рассомтреть продвижение товаров в регионы, уделив внимание условиям по рассрочке платежей.
*/

/* Задача 4. Активность пользователей по первому месяцу заказа в 2023 году
 * Разбеение пользователей на группы в зависимости от того, в какой месяц 2023 года они совершили первый заказ.
 * Для каждой группы посчитано:
 * - общее количество клиентов, число заказов и среднюю стоимость одного заказа;
 * - средний рейтинг заказа;
 * - доля пользователей, использующих денежные переводы при оплате;
 * - средняя продолжительность активности пользователя.
*/

SELECT 
EXTRACT(MONTH FROM first_order_ts) months,
TO_CHAR(first_order_ts, 'Month') AS month_name, -- название месяца
COUNT(user_id) count_users,-- общее число клиентов 
SUM(total_orders) count_orders, --и заказов
ROUND(SUM(total_order_costs)/NULLIF(SUM(total_orders),0),3) avg_orders, -- среднюю стоимость одного заказа
ROUND(SUM(avg_order_rating*num_orders_with_rating)/NULLIF(SUM(num_orders_with_rating),0),3) avg_rating,--средний рейтинг заказа
ROUND(COUNT(CASE WHEN used_money_transfer = 1 THEN user_id END)::numeric/COUNT(user_id),3) money_transfer_share, --долю пользователей, использующих денежные переводы при оплате
AVG(lifetime) avg_lifetime --среднюю продолжительность активности пользователя
FROM ds_ecom.product_user_features
WHERE EXTRACT (YEAR FROM first_order_ts) = 2023
GROUP BY months, month_name

